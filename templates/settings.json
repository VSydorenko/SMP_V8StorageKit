{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git ls-files:*)",
      "Bash(git rev-list:*)",
      "Bash(git check-ignore:*)",
      "Bash(git bundle verify:*)",
      "mcp__plugin_unica_unica__unica_view",
      "mcp__plugin_unica_unica__unica_search",
      "mcp__plugin_unica_unica__unica_resolve",
      "mcp__plugin_unica_unica__unica_docs",
      "mcp__plugin_unica_unica__unica_check",
      "mcp__plugin_unica_unica__unica_diff",
      "mcp__plugin_unica_unica__unica_task_get",
      "mcp__plugin_unica_unica__unica_task_result"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh release:*)",
      "mcp__plugin_unica_unica__unica_run",
      "mcp__plugin_unica_unica__unica_apply",
      "mcp__plugin_unica_unica__unica_task_cancel"
    ],
    "deny": [
      "Bash(gitsync:*)",
      "Bash(oscript:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/session-start.ps1",
            "async": false,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
