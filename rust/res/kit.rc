// Ресурс версії й маніфест bin/kit.exe. Компілює його збірка поставки tools/build-kit-exe.ps1 (локально з MSVC
// чи на CI): rc.exe -> kit.res -> аргумент лінкера. Номер версії — з .claude-plugin/plugin.json через
// kit-version.h, який скрипт генерує поруч із kit.res. Голий cargo build ресурсу не вбудовує — така збірка
// лише для тестів, і `build-kit-exe.ps1 -Verify` її відхиляє.
// Чому ресурс є: збірка без нього й без лінкера MSVC отримала ML-детекцію Defender (план #51 §14,
// docs/research/2026-11-21-defender-kit-exe.md).
#pragma code_page(65001)
#include <winver.h>
#include "kit-version.h"

1 VERSIONINFO
FILEVERSION KIT_VERSION_NUM
PRODUCTVERSION KIT_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "v8storagekit"
            VALUE "FileDescription", "v8storagekit command entry"
            VALUE "FileVersion", KIT_VERSION_STR
            VALUE "InternalName", "kit"
            VALUE "LegalCopyright", "v8storagekit contributors"
            VALUE "OriginalFilename", "kit.exe"
            VALUE "ProductName", "v8storagekit"
            VALUE "ProductVersion", KIT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "kit.manifest"
