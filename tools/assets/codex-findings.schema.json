{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "codex-audit findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["files_read", "findings"],
  "properties": {
    "files_read": {
      "type": "array",
      "description": "Every repository file the auditor actually read.",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "description": "One item per defect; an empty list means no findings.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "location", "defect", "evidence"],
        "properties": {
          "severity": { "type": "string", "enum": ["BLOCKER", "MAJOR", "MINOR"] },
          "location": { "type": "string", "description": "Place in the audited document or code." },
          "defect": { "type": "string" },
          "evidence": { "type": "string", "description": "path:line in the repository." }
        }
      }
    }
  }
}
