{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pwsh >/dev/null 2>&1 && pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.ps1\"; exit 0",
            "async": false,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
