// Експеримент #51: ресурс версії й маніфест для kit.exe (варіант V2). Поза rust/, щоб не змінювати відбиток.
#include <winver.h>

1 VERSIONINFO
FILEVERSION 1,6,7,0
PRODUCTVERSION 1,6,7,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "v8storagekit"
            VALUE "FileDescription", "v8storagekit command entry"
            VALUE "FileVersion", "1.6.7.0"
            VALUE "InternalName", "kit"
            VALUE "LegalCopyright", "v8storagekit contributors"
            VALUE "OriginalFilename", "kit.exe"
            VALUE "ProductName", "v8storagekit"
            VALUE "ProductVersion", "1.6.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "kit.manifest"
