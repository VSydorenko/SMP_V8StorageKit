{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git check-ignore:*)",
      "Bash(git bundle verify:*)",
      "Bash(pwsh -NoProfile -File tools/tests/Run-Tests.ps1 -ExcludeTag Integration)",
      "Bash(pwsh -NoProfile -File tools/tests/Run-Tests.ps1 -ExcludeTag Integration -Only:*)",
      "Bash(pwsh -NoProfile -File tools/check-environment.ps1)",
      "Bash(pwsh -NoProfile -File tools/kit.ps1 check:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh release:*)"
    ],
    "deny": [
      "Bash(gitsync:*)",
      "Bash(oscript:*)"
    ]
  }
}
