#!/usr/bin/env bash
# Обгортка команди процесу v8storagekit (ADR-0002): ім'я команди = ім'я цього файлу.
# Нова команда — копія цього файлу під її ім'ям (з бітом виконання) і така сама копія <ім'я>.ps1.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
exec pwsh -NoProfile -File "$here/../tools/kit.ps1" "$(basename "${BASH_SOURCE[0]}")" "$@"
